<Window x:Class="HabitTrackerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Habit Tracker - Управление привычками" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <DockPanel>

        <!-- ВЕРХНЕЕ МЕНЮ -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Сохранить" Click="Save_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="_Загрузить" Click="Load_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Выход" Click="Exit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Вид">
                <MenuItem Header="_Светлая тема" Click="LightTheme_Click"/>
                <MenuItem Header="_Тёмная тема" Click="DarkTheme_Click"/>
            </MenuItem>
            <MenuItem Header="_Помощь">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ПАНЕЛЬ ИНСТРУМЕНТОВ -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="💾" ToolTip="Сохранить" Click="Save_Click"/>
                <Button Content="📂" ToolTip="Загрузить" Click="Load_Click"/>
                <Separator/>
                <ToggleButton x:Name="ToggleExtraPanelButton" Content="📁 Скрыть панель" Click="ToggleExtraPanel_Click"/>
            </ToolBar>
        </ToolBarTray>

        <!-- СТРОКА СОСТОЯНИЯ -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Готов"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Текущая дата: "/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="CurrentDateTextBlock"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ОСНОВНАЯ СЕТКА 3 КОЛОНКИ -->
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition x:Name="RightColumn" Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ПАНЕЛЬ (ЛИЧНЫЕ ДАННЫЕ) -->
            <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="8" Padding="5" Margin="2">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Text="👤 ЛИЧНЫЕ ДАННЫЕ" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Label Content="Имя:"/>
                        <TextBox x:Name="FirstNameTextBox" Margin="0,0,0,10"/>

                        <Label Content="Фамилия:"/>
                        <TextBox x:Name="LastNameTextBox" Margin="0,0,0,10"/>

                        <Label Content="Пароль:"/>
                        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10"/>

                        <Label Content="Дата рождения:"/>
                        <DatePicker x:Name="BirthDatePicker" Margin="0,0,0,10"/>

                        <Label Content="Образование:"/>
                        <ComboBox x:Name="EducationComboBox" Margin="0,0,0,10" SelectedIndex="0">
                            <ComboBoxItem>Среднее</ComboBoxItem>
                            <ComboBoxItem>Среднее специальное</ComboBoxItem>
                            <ComboBoxItem>Высшее</ComboBoxItem>
                            <ComboBoxItem>Аспирантура</ComboBoxItem>
                        </ComboBox>

                        <Label Content="Уровень активности:"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="LowActivity" Content="Низкий" GroupName="Activity" Margin="0,0,10,0"/>
                            <RadioButton x:Name="MediumActivity" Content="Средний" GroupName="Activity" Margin="0,0,10,0" IsChecked="True"/>
                            <RadioButton x:Name="HighActivity" Content="Высокий" GroupName="Activity"/>
                        </StackPanel>

                        <Label Content="Хобби:"/>
                        <ListBox x:Name="HobbiesListBox" SelectionMode="Multiple" Height="100">
                            <ListBoxItem>Спорт</ListBoxItem>
                            <ListBoxItem>Чтение</ListBoxItem>
                            <ListBoxItem>Музыка</ListBoxItem>
                            <ListBoxItem>Программирование</ListBoxItem>
                            <ListBoxItem>Путешествия</ListBoxItem>
                        </ListBox>

                        <CheckBox x:Name="NotificationsCheckBox" Content="Получать уведомления" Margin="0,10,0,5"/>
                        <CheckBox x:Name="PublicStatsCheckBox" Content="Публичная статистика" Margin="0,0,0,5"/>
                        <CheckBox x:Name="AutoSaveCheckBox" Content="Автосохранение" IsChecked="True"/>

                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="💾 Сохранить профиль" Width="120" Margin="0,0,10,5" Click="SaveProfile_Click"/>
                            <Button Content="🗑️ Сброс" Width="80" Click="ResetProfile_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ЦЕНТРАЛЬНАЯ ПАНЕЛЬ (ПРИВЫЧКИ) -->
            <Border Grid.Column="1" Background="#FAFAFA" CornerRadius="8" Padding="5" Margin="2">
                <StackPanel>
                    <TextBlock Text="✅ ПРИВЫЧКИ" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="Продуктивность:"/>
                    <WrapPanel Margin="0,0,0,10">
                        <RepeatButton Content="−" Width="30" Height="25" Click="DecreaseProductivity_Click" Margin="0,0,5,0"/>
                        <Slider x:Name="ProductivitySlider" Minimum="0" Maximum="100" Value="50" Width="200" Margin="0,0,5,0"/>
                        <RepeatButton Content="+" Width="30" Height="25" Click="IncreaseProductivity_Click"/>
                    </WrapPanel>

                    <TextBlock Text="Удовлетворённость:"/>
                    <Slider x:Name="SatisfactionSlider" Minimum="0" Maximum="100" Value="70" Margin="0,0,0,10"/>

                    <TextBlock Text="Прогресс дня:"/>
                    <ProgressBar x:Name="DayProgressBar" Minimum="0" Maximum="100" Height="20" Margin="0,0,0,10"/>

                    <TextBlock Text="Заметки:"/>
                    <RichTextBox x:Name="NotesRichTextBox" Height="80" Margin="0,0,0,10"/>

                    <TextBlock Text="Календарь:"/>
                    <Calendar x:Name="HabitsCalendar" Margin="0,0,0,10"/>

                    <TextBlock Text="Список привычек:"/>
                    <DataGrid x:Name="HabitsDataGrid" AutoGenerateColumns="False" Height="150" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Привычка" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Выполнено" Binding="{Binding IsDone}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel>
                        <TextBox x:Name="NewHabitTextBox" Width="150" Margin="0,0,10,0"/>
                        <TextBox x:Name="NewHabitTimeTextBox" Width="60" Text="12:00" Margin="0,0,10,0"/>
                        <Button Content="➕ Добавить" Click="AddHabit_Click"/>
                    </WrapPanel>

                    <!-- Аватар -->
                    <TextBlock Text="Фото профиля:" FontWeight="Bold" Margin="0,15,0,5"/>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Width="100" Height="100" Margin="0,0,0,5">
                        <Image x:Name="AvatarImage" Width="100" Height="100" Stretch="UniformToFill"/>
                    </Border>
                    <Button Content="📸 Загрузить аватар" Click="LoadAvatar_Click" Width="120" Margin="0,0,0,10"/>

                </StackPanel>
            </Border>

            <!-- ПРАВАЯ ПАНЕЛЬ (СТАТИСТИКА) -->
            <Border x:Name="ExtraPanel" Grid.Column="2" Background="#F0F0F0" CornerRadius="8" Padding="5" Margin="2">
                <StackPanel>
                    <TextBlock Text="📊 СТАТИСТИКА" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Категории:" FontWeight="Bold"/>
                    <TreeView x:Name="CategoriesTreeView" Height="150" Margin="0,5,0,10"/>
                    <TextBlock Text="Детали:" FontWeight="Bold"/>
                    <ListView x:Name="StatisticsListView" Height="150" Margin="0,5,0,10">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Дата" Width="60" DisplayMemberBinding="{Binding Date}"/>
                                <GridViewColumn Header="Привычка" Width="80" DisplayMemberBinding="{Binding HabitName}"/>
                                <GridViewColumn Header="Статус" Width="60" DisplayMemberBinding="{Binding Status}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>