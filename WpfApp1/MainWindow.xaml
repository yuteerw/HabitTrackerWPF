<Window x:Class="HabitTrackerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Habit Tracker" 
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== ЛЕВАЯ ПАНЕЛЬ (из ветки profile-tab) ========== -->
        <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="8" Padding="5" Margin="2">
            <ScrollViewer>
                <TabControl>
                    <TabItem Header="👤 Личные данные">
                        <StackPanel Margin="5">

                            <GroupBox Header="Основная информация">
                                <StackPanel Margin="10">
                                    <Label Content="Имя:"/>
                                    <TextBox x:Name="FirstNameTextBox" Margin="0,0,0,10"/>
                                    <Label Content="Фамилия:"/>
                                    <TextBox x:Name="LastNameTextBox" Margin="0,0,0,10"/>
                                    <Label Content="Пароль:"/>
                                    <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10"/>
                                    <Label Content="Дата рождения:"/>
                                    <DatePicker x:Name="BirthDatePicker" Margin="0,0,0,10"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Образование и активность">
                                <StackPanel Margin="10">
                                    <Label Content="Образование:"/>
                                    <ComboBox x:Name="EducationComboBox" Margin="0,0,0,10" SelectedIndex="0">
                                        <ComboBoxItem>Среднее</ComboBoxItem>
                                        <ComboBoxItem>Среднее специальное</ComboBoxItem>
                                        <ComboBoxItem>Высшее</ComboBoxItem>
                                        <ComboBoxItem>Аспирантура</ComboBoxItem>
                                    </ComboBox>

                                    <Label Content="Уровень активности:"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton x:Name="LowActivity" Content="Низкий" GroupName="Activity" Margin="0,0,15,0"/>
                                        <RadioButton x:Name="MediumActivity" Content="Средний" GroupName="Activity" Margin="0,0,15,0" IsChecked="True"/>
                                        <RadioButton x:Name="HighActivity" Content="Высокий" GroupName="Activity"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Хобби">
                                <ListBox x:Name="HobbiesListBox" SelectionMode="Multiple" Height="120">
                                    <ListBoxItem>Спорт</ListBoxItem>
                                    <ListBoxItem>Чтение</ListBoxItem>
                                    <ListBoxItem>Музыка</ListBoxItem>
                                    <ListBoxItem>Программирование</ListBoxItem>
                                    <ListBoxItem>Путешествия</ListBoxItem>
                                </ListBox>
                            </GroupBox>

                            <GroupBox Header="Настройки">
                                <StackPanel Margin="10">
                                    <CheckBox x:Name="NotificationsCheckBox" Content="Получать уведомления" Margin="0,0,0,5"/>
                                    <CheckBox x:Name="PublicStatsCheckBox" Content="Показывать статистику публично" Margin="0,0,0,5"/>
                                    <CheckBox x:Name="AutoSaveCheckBox" Content="Автосохранение" IsChecked="True"/>
                                </StackPanel>
                            </GroupBox>

                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="SaveProfileButton" Content="💾 Сохранить профиль" Width="130" Height="30" Margin="0,0,10,5" Click="SaveProfile_Click"/>
                                <Button x:Name="ResetProfileButton" Content="🗑️ Сброс" Width="100" Height="30" Click="ResetProfile_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="✅ Привычки">
                        <TextBlock Text="Переключитесь на центральную панель" Margin="10"/>
                    </TabItem>

                    <TabItem Header="📊 Статистика">
                        <TextBlock Text="Будет в следующей ветке" Margin="10"/>
                    </TabItem>
                </TabControl>
            </ScrollViewer>
        </Border>

        <!-- ========== ЦЕНТРАЛЬНАЯ ПАНЕЛЬ (из ветки habits-tab) ========== -->
        <Border Grid.Column="1" Background="#FAFAFA" CornerRadius="8" Padding="5" Margin="2">
            <ScrollViewer>
                <StackPanel>

                    <TextBlock Text="📊 Продуктивность дня" FontWeight="Bold" Margin="0,5,0,5"/>
                    <Slider x:Name="ProductivitySlider" Minimum="0" Maximum="100" Value="50" Margin="0,5,0,10"/>

                    <TextBlock Text="😊 Удовлетворённость" FontWeight="Bold" Margin="0,5,0,5"/>
                    <Slider x:Name="SatisfactionSlider" Minimum="0" Maximum="100" Value="70" Margin="0,5,0,10"/>

                    <TextBlock Text="📈 Прогресс дня" FontWeight="Bold" Margin="0,5,0,5"/>
                    <ProgressBar x:Name="DayProgressBar" Minimum="0" Maximum="100" Value="50" Height="25" Margin="0,5,0,10"/>

                    <TextBlock Text="📝 Заметки о привычках" FontWeight="Bold" Margin="0,5,0,5"/>
                    <RichTextBox x:Name="NotesRichTextBox" Height="100" Margin="0,5,0,10"/>

                    <TextBlock Text="📅 Календарь" FontWeight="Bold" Margin="0,5,0,5"/>
                    <Calendar x:Name="HabitsCalendar" Margin="0,5,0,10"/>

                    <TextBlock Text="📋 Список привычек" FontWeight="Bold" Margin="0,5,0,5"/>
                    <DataGrid x:Name="HabitsDataGrid" AutoGenerateColumns="False" Height="200" Margin="0,5,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Привычка" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Выполнено" Binding="{Binding IsDone}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Margin="0,5,0,10">
                        <TextBox x:Name="NewHabitTextBox" Width="200" Height="25" Margin="0,0,10,0" ToolTip="Введите название привычки"/>
                        <TextBox x:Name="NewHabitTimeTextBox" Width="80" Height="25" Margin="0,0,10,0" Text="12:00" ToolTip="Время (например, 19:00)"/>
                        <Button Content="➕ Добавить привычку" Click="AddHabit_Click"/>
                    </WrapPanel>

                    <TextBlock x:Name="StatusTextBlock" Foreground="Gray" FontSize="11" Text="Готов" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ========== ПРАВАЯ ПАНЕЛЬ (заглушка) ========== -->
        <Border Grid.Column="2" Background="#F0F0F0" CornerRadius="8" Padding="5" Margin="2">
            <TextBlock Text="📊 Статистика будет здесь (ветка stats-tab)" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
        </Border>

    </Grid>
</Window>