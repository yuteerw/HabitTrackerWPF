<Window x:Class="HabitTrackerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Habit Tracker - Управление привычками" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <DockPanel>

        <!-- ========== ВЕРХНЕЕ МЕНЮ ========== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Сохранить" Click="Save_Click" InputGestureText="Ctrl+S"/>
                <MenuItem Header="_Загрузить" Click="Load_Click" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="_Выход" Click="Exit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Вид">
                <MenuItem Header="_Светлая тема" Click="LightTheme_Click"/>
                <MenuItem Header="_Тёмная тема" Click="DarkTheme_Click"/>
            </MenuItem>
            <MenuItem Header="_Помощь">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- ========== ПАНЕЛЬ ИНСТРУМЕНТОВ ========== -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="💾" ToolTip="Сохранить" Click="Save_Click"/>
                <Button Content="📂" ToolTip="Загрузить" Click="Load_Click"/>
                <Separator/>
                <ToggleButton x:Name="ToggleExtraPanelButton" Content="📁 Скрыть панель" Click="ToggleExtraPanel_Click"/>
            </ToolBar>
        </ToolBarTray>

        <!-- ========== СТРОКА СОСТОЯНИЯ ========== -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Готов"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="Текущая дата: "/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="CurrentDateTextBlock"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ========== ОСНОВНАЯ СЕТКА 3 КОЛОНКИ ========== -->
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition x:Name="RightColumn" Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ПАНЕЛЬ (заглушка) -->
            <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="8" Padding="5" Margin="2">
                <StackPanel>
                    <TextBlock Text="👤 ЛИЧНЫЕ ДАННЫЕ" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Здесь будут поля из ветки profile-tab" TextWrapping="Wrap" FontSize="11" Foreground="Gray"/>
                    <TextBox Text="Иван" Margin="0,10,0,0"/>
                    <TextBox Text="Иванов" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- ЦЕНТРАЛЬНАЯ ПАНЕЛЬ -->
            <Border Grid.Column="1" Background="#FAFAFA" CornerRadius="8" Padding="5" Margin="2">
                <StackPanel>
                    <TextBlock Text="✅ ПРИВЫЧКИ" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- RepeatButton для быстрого изменения продуктивности -->
                    <TextBlock Text="Продуктивность:" Margin="0,0,0,5"/>
                    <WrapPanel Margin="0,0,0,10">
                        <RepeatButton x:Name="DecreaseProductivityButton" Content="−" Width="30" Height="25" Click="DecreaseProductivity_Click" Margin="0,0,5,0"/>
                        <Slider x:Name="ProductivitySlider" Minimum="0" Maximum="100" Value="50" Width="200" Margin="0,0,5,0"/>
                        <RepeatButton x:Name="IncreaseProductivityButton" Content="+" Width="30" Height="25" Click="IncreaseProductivity_Click"/>
                    </WrapPanel>

                    <TextBlock Text="Значение: " Margin="0,0,0,5"/>
                    <TextBlock x:Name="ProductivityValueTextBlock" Text="50%" Margin="0,0,0,10"/>

                    <!-- Аватар пользователя -->
                    <TextBlock Text="Фото профиля:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Width="120" Height="120" Margin="0,0,0,5">
                        <Image x:Name="AvatarImage" Width="120" Height="120" Stretch="UniformToFill"/>
                    </Border>
                    <Button Content="📸 Загрузить аватар" Click="LoadAvatar_Click" Width="120" Margin="0,0,0,10"/>

                </StackPanel>
            </Border>

            <!-- ПРАВАЯ ПАНЕЛЬ (может скрываться ToggleButton) -->
            <Border x:Name="ExtraPanel" Grid.Column="2" Background="#F0F0F0" CornerRadius="8" Padding="5" Margin="2">
                <StackPanel>
                    <TextBlock Text="📊 СТАТИСТИКА" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Здесь будет статистика из ветки stats-tab" TextWrapping="Wrap" FontSize="11" Foreground="Gray"/>
                    <ListView Height="150" Margin="0,10,0,0">
                        <ListViewItem>Здоровье: 80%</ListViewItem>
                        <ListViewItem>Развитие: 60%</ListViewItem>
                        <ListViewItem>Продуктивность: 75%</ListViewItem>
                    </ListView>
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>