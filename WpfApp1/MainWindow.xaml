<W<Window x:Class="HabitTrackerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Habit Tracker - Статистика" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== ЛЕВАЯ ПАНЕЛЬ (заглушка) ========== -->
        <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="8" Padding="5" Margin="2">
            <TextBlock Text="Личные данные будут здесь (ветка profile-tab)" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- ========== ЦЕНТРАЛЬНАЯ ПАНЕЛЬ (заглушка) ========== -->
        <Border Grid.Column="1" Background="#FAFAFA" CornerRadius="8" Padding="5" Margin="2">
            <TextBlock Text="Привычки будут здесь (ветка habits-tab)" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- ========== ПРАВАЯ ПАНЕЛЬ (СТАТИСТИКА) ========== -->
        <Border Grid.Column="2" Background="#F0F0F0" CornerRadius="8" Padding="5" Margin="2">
            <StackPanel>

                <TextBlock Text="📊 СТАТИСТИКА" FontWeight="Bold" FontSize="14" TextAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="🌳 Категории привычек" FontWeight="Bold" Margin="0,5,0,5"/>
                <TreeView x:Name="CategoriesTreeView" Height="200" Margin="0,5,0,10"/>

                <TextBlock Text="📋 Детальная статистика" FontWeight="Bold" Margin="0,5,0,5"/>
                <ListView x:Name="StatisticsListView" Height="200" Margin="0,5,0,10">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Дата" Width="80" DisplayMemberBinding="{Binding Date}"/>
                            <GridViewColumn Header="Привычка" Width="100" DisplayMemberBinding="{Binding HabitName}"/>
                            <GridViewColumn Header="Статус" Width="80" DisplayMemberBinding="{Binding Status}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Статусная строка внутри панели -->
                <Border Background="White" CornerRadius="5" Padding="5" Margin="0,10,0,0">
                    <TextBlock x:Name="StatusTextBlock" Foreground="Gray" FontSize="11" Text="Выберите категорию или элемент статистики"/>
                </Border>

            </StackPanel>
        </Border>

    </Grid>
    </Window>